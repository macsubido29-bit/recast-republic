const path = require("node:path");
const Database = require("better-sqlite3");

const projectRoot = path.resolve(__dirname, "..");
require("dotenv").config({
  path: process.env.ENV_FILE || path.join(projectRoot, ".env")
});

const email = String(process.argv[2] || "").trim().toLowerCase();
const adminEmail = String(process.env.ADMIN_EMAIL || "recastrepublic29@gmail.com").trim().toLowerCase();

if (!email || email !== adminEmail) {
  console.error(`Usage: npm run admin:promote -- ${adminEmail}`);
  console.error("Only the email configured by ADMIN_EMAIL can be promoted by this command.");
  process.exit(1);
}

const databasePath = path.resolve(projectRoot, process.env.DB_PATH || "data/recast-republic.sqlite");
let database;

try {
  database = new Database(databasePath);
  const user = database.prepare("select id, role from app_users where email = ?").get(email);
  if (!user) {
    console.error(`No account exists for ${email}. Register this account in the store, then run this command again.`);
    process.exitCode = 1;
  } else if (user.role === "admin") {
    console.log(`${email} already has admin access.`);
  } else {
    database.prepare("update app_users set role = 'admin' where id = ?").run(user.id);
    console.log(`Admin access granted to ${email}. Sign out and sign back in to refresh the account role.`);
  }
} catch (error) {
  console.error(`Could not promote the configured admin account: ${error.message}`);
  process.exitCode = 1;
} finally {
  database?.close();
}
