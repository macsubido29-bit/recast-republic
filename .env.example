PORT=3000
HOST=127.0.0.1
DB_PATH=./data/recast-republic.sqlite
NODE_ENV=development
WEBSITE_URL=https://macsubido29-bit.github.io
# Optional comma-separated additional browser origins:
# CORS_ORIGINS=https://macsubido29-bit.github.io,https://www.example.com
ADMIN_EMAIL=recastrepublic29@gmail.com

# Optional: configure SMTP to email the admin about new orders, order updates,
# and support messages. For Gmail, use a Google App Password (not your account
# password). Without these settings, records are still saved without email.
# Gmail defaults; override host/port/security when using another provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER.
SMTP_FROM=

# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
