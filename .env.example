PORT=3000
HOST=127.0.0.1
DB_PATH=./data/recast-republic.sqlite
NODE_ENV=development
CORS_ORIGINS=https://macsubido29-bit.github.io,https://www.recastrepublic.com
ADMIN_EMAIL=recastrepublic29@gmail.com

# Optional: configure SMTP to email the admin about new orders, order updates,
# and support messages. Without these settings, records are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
